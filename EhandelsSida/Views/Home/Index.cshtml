@model IEnumerable<EhandelsSida.Models.Product>

<h2>Produkter</h2>

<div class="container">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card" style="width: 18rem;">
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@item.Name</h5>
                        <p class="card-text">@item.Description</p>
                        <p class="card-text"><strong>@item.Price kr</strong></p>
                        <a href="#" class="btn btn-primary">Lägg i varukorg</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

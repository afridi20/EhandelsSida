@model EhandelsSida.Models.Product

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 style="width: 60%; height: 400px; object-fit: cover; border-radius: 8px;"
                 alt="@Model.Name" />
        </div>

        <div class="col-md-6">
            <h2>@Model.Name</h2>
            <p>@Model.Description</p>

            <h3 class="text-success">@Model.Price kr</h3>

            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                <input type="hidden" name="productId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary btn-lg w-100 mt-3">
                    Lägg i varukorg
                </button>
            </form>

            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary w-100 mt-2">
                Tillbaka
            </a>
        </div>
    </div>
</div>
